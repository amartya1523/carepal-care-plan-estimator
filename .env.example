# API server
PORT=4000

# Admin login for /admin (change both before deploying anywhere)
ADMIN_USERNAME=ops
ADMIN_PASSWORD=change-me-please

# Used to sign admin session tokens. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional overrides
# DB_PATH=server/data/carepal.db
# PRICING_PATH=config/pricing.json
