{
  "name": "carepal-estimator",
  "private": true,
  "version": "0.1.0",
  "description": "Self-serve care plan builder and price estimator for home care in India.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix web",
    "dev:api": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm start --prefix server",
    "seed": "npm run seed --prefix server --",
    "test": "node --test 'shared/test/*.test.js' && npm test --prefix server"
  },
  "license": "MIT"
}
